APP_ENV=DEV
APP_URL=http://localhost
API_KEY=
APP_SECRET=""
ENCRYPTION_KEY=""
CALDEV_URL=http://localhost:8443
WORKSPACE_API_URL=http://localhost:8090
MEET_API_URL=http://localhost:8085
MEET_URL=https://meet.airsend.in
TENOR_API_KEY=

# Tasks (Kaneo) web app mounted at /v2/tasks. The browser calls the Kaneo API directly (no Next proxy): Kaneo verifies the
# AirSend access_token itself. The URL is a runtime value (the root layout injects it as window.__RUNTIME_CONFIG__.TASKS_API_URL),
# so no NEXT_PUBLIC_ variable and no rebuild. The API must be on the same site as the app so the cookie is sent, and its
# CORS_ORIGINS must include this app's origin. Defaults to http://localhost:1337 in development.
TASKS_API_URL=http://localhost:1337
# TASKS_TURNSTILE_SITE_KEY=

# Files (Nimbus) web app mounted at /v2/files, and the workspace file uploads. The browser calls the files backend
# directly: the URL is a runtime value (the root layout injects it as window.__RUNTIME_CONFIG__.FILES_API_URL), so no
# NEXT_PUBLIC_ variable and no rebuild is needed to change it. The backend verifies the AirSend access_token itself and
# must be on the same site as the app so the cookie is sent. Defaults to http://localhost:1284 in development.
FILES_API_URL=http://localhost:1284
